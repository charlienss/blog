# 依赖 / 构建产物（本博客零依赖，通常无 node_modules）
node_modules/
dist/
.wrangler/
.dev.vars

# 本地运行时/日志
*.log
.DS_Store
Thumbs.db

# 编辑器
.vscode/
.idea/

# 敏感占位（wrangler.toml 已用占位符；此处防止误提交真实凭据）
.dev.vars

# CI 生成的真实 KV id 部署配置（Actions 部署时临时生成，用完即删）
wrangler.workers.ci.toml

# 本地备份/草稿
*.bak*

# 字体：源 TTF 不入库；fonts/dreamserif/ 分片必须随仓库部署（Pages 静态托管）
public/fonts/*
!public/fonts/dreamserif/
markdown/*